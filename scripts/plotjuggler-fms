#!/bin/sh
# URL handler for FMS deep links: plotjuggler://fms/flight/<id>
#
# Registered through io.plotjuggler.PlotJugglerFMS.desktop, so clicking
# "Open in PlotJuggler" on an FMS flight page lands here with the URL as $1.
#
# The link carries nothing but a flight id. The FMS server is hardcoded in the
# plugin so a crafted URL cannot aim it - and the API token it sends - at
# somebody else's host, and the token is not in the link either: it would end up
# in browser history and server logs. The browser panel takes the token from
# FMS_API_TOKEN or, after the first time it is typed in, from QSettings.
set -eu

url=${1-}

# Launched from an application menu rather than a link: plain PlotJuggler.
case $url in
  plotjuggler://*)
    # The id comes from a URL anyone can craft, so accept digits and nothing else.
    id=$(printf '%s' "$url" | sed -n 's#^plotjuggler://fms/flight/\([0-9][0-9]*\)/\{0,1\}\([?#].*\)\{0,1\}$#\1#p')
    if [ -z "$id" ]; then
      echo "plotjuggler-fms: not a flight link: $url" >&2
      exit 1
    fi
    FMS_FLIGHT_ID=$id
    export FMS_FLIGHT_ID
    # drop the URL, pass any extra arguments through
    shift
    ;;
esac

# Prefer the plotjuggler installed next to this script: under Nix the profile's
# bin is not necessarily on the PATH of whatever launched the URL handler.
sibling=$(dirname "$0")/plotjuggler
if [ -x "$sibling" ]; then
  exec "$sibling" "$@"
fi
exec plotjuggler "$@"
